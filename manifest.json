{
  "manifest_version": 3,
  "name": "MindMap Pro - Offline",
  "version": "3.1",
  "description": "Offline Mind Map with Split Scripts",
  "permissions": ["tabs", "storage", "unlimitedStorage"],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "Open MindMap"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'self'"
  }
}